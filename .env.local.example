# Çoklu cihaz senkronu için Supabase bilgileri.
# Bu dosyayı ".env.local" olarak kopyala ve değerleri Supabase panelinden doldur.
# (Boş bırakırsan uygulama otomatik olarak sadece bu cihazda — localStorage — çalışır.)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Film araması için TMDB (themoviedb.org) v3 API anahtarı.
# Sunucuda kalır, tarayıcıya sızmaz. Boşsa film arama devre dışı olur.
TMDB_API_KEY=
